---
import type { MissionStatsContent } from "../../content/home";

interface Props {
  content: MissionStatsContent;
}

const { content } = Astro.props;
---

<section id="mission" class="bg-white px-4 pt-6 pb-3 lg:pt-12 lg:pb-6 lg:px-0 relative overflow-hidden">
  <!-- Background Texture -->
  <div
    class="absolute inset-0 opacity-15 bg-[url('/images/group-8-texture-2-gray-1.png')] bg-cover bg-center mix-blend-overlay pointer-events-none"
  >
  </div>

  <div class="layout-shell relative z-10">
    <!-- Mobile & Tablet: Custom Design with Background Image -->
    <div
      class="lg:hidden relative overflow-hidden rounded-[18px] md:rounded-[24px] border border-white/20 bg-[#0099FF] shadow-[0_12px_28px_rgba(0,0,0,0.10)] w-full min-h-[200px] md:min-h-[260px] flex items-center justify-center py-8 px-4"
    >
      <!-- Background Image -->
      <img
        src="/images/figma-14-3169.png"
        alt=""
        class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-multiply pointer-events-none"
      />

      <!-- Content -->
      <div class="relative z-10 w-full flex flex-col items-center justify-center">
        <a
          href="https://www.everynation.org/mission2029/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:scale-105 transition-transform cursor-pointer relative z-30 flex flex-col items-center w-full max-w-[280px] sm:max-w-[340px] md:max-w-[420px]"
        >
          <img
            src="/images/missionMoblie.png"
            alt="Mission 2029"
            class="w-full h-auto object-contain mx-auto drop-shadow-lg"
          />
        </a>
      </div>
    </div>

    <!-- Desktop: Static Image Banner -->
    <div
      class="hidden lg:block w-full relative rounded-[20px] lg:rounded-[24px] overflow-hidden shadow-[0_12px_28px_rgba(0,0,0,0.10)] border border-[#e5e5e5]"
    >
      <a
        href="https://www.everynation.org/mission2029/"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full hover:scale-[1.01] transition-transform duration-300 relative z-20"
      >
        <img
          src="/images/QR_Mission 2029 banner.jpg"
          alt="Mission 2029"
          class="w-full h-auto object-cover block"
        />
      </a>
    </div>
  </div>
</section>
