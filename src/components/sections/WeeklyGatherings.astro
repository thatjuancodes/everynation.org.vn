---
import type { WeeklyGatheringsContent } from "../../content/home";

interface Props {
  content: WeeklyGatheringsContent;
}

const { content } = Astro.props;

const words = content.title.split(/\s+/).filter(Boolean);
const titleLines = [
  words.slice(0, 2).join(" "),
  words.slice(2).join(" "),
].filter(Boolean);
---

<section id="gatherings" class="relative -mt-5 px-4 pb-16 pt-12 lg:px-0">
  <div class="layout-shell">
    <div
      class="relative grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center"
    >
      <div
        class="absolute left-[38%] bottom-[140px] z-40 hidden lg:block"
        style="transform: rotate(-10deg);"
      >
        <img
          src="/images/arow1.png"
          alt=""
          class="w-[160px] h-auto object-contain drop-shadow-xl"
          loading="lazy"
        />
      </div>
      <div class="relative order-1 z-20 self-center lg:order-1 lg:-mr-16">
        <div
          class="overflow-hidden rounded-[14px] shadow-[0_22px_50px_rgba(0,0,0,0.16)] lg:rounded-[16px] h-[470px] sm:h-[510px] lg:h-[570px] max-w-[520px]"
        >
          <img
            src="/images/figma-rect-22-896.png"
            alt="Congregation gathered during service"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div class="relative order-4 lg:order-2 z-10 lg:-ml-[120px]">
        <div
          class="relative rounded-[23px] border border-slate-200/80 bg-[#f6f6f6] shadow-[0_18px_42px_rgba(0,0,0,0.14)] lg:pl-[100px]"
        >
          <div
            class="relative flex h-full flex-col items-center justify-center px-6 py-8 sm:px-10 sm:py-10"
          >
            <div class="relative">
              <div>
                <h2
                  class="text-center text-[30px] font-bold uppercase leading-[40px] tracking-[-1px] text-[#2964AF] sm:text-[44px] sm:leading-[54px] lg:text-[48px] lg:leading-[56px] lg:tracking-[-1.92px]"
                  style="font-family: 'Inter', 'Inter', sans-serif;"
                >
                  {
                    (titleLines.length ? titleLines : [content.title]).map(
                      (line) => <span class="block">{line}</span>,
                    )
                  }
                </h2>
                <div class="mt-6 flex justify-center">
                  <ul
                    class="w-fit space-y-4 rounded-[4px] border border-slate-300 bg-[#f9f9f9] px-6 py-6 text-[16px] font-normal leading-[19px] text-[#000000]"
                  >
                    {
                      content.services.map((service) => (
                        <li class="flex items-start gap-4">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="w-6 h-6 text-[#1A1A1A] shrink-0"
                          >
                            <>
                              <circle cx="12" cy="12" r="10" />
                              <polyline points="12 6 12 12 16 14" />
                            </>
                          </svg>
                          <span class="leading-[19px]">
                            {service.label}: {service.time}
                          </span>
                        </li>
                      ))
                    }
                    <li class="flex items-start gap-4">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="w-6 h-6 text-[#1A1A1A] shrink-0"
                        ><path
                          d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                        ></path><circle cx="12" cy="10" r="3"></circle></svg
                      >
                      <span class="leading-[19px]">{content.location}</span>
                    </li>
                  </ul>
                </div>
                <div class="relative mt-6">
                  <div
                    class="overflow-hidden rounded-[14px] border border-slate-200 shadow-[0_12px_26px_rgba(0,0,0,0.12)] h-[160px] sm:h-[180px] lg:h-[200px]"
                  >
                    <img
                      src="/images/figma-15-584.png"
                      alt="Map showing church location"
                      class="h-full w-full object-cover"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
              <div class="mt-8 flex justify-center">
                <a
                  href="#connect"
                  class="inline-flex min-w-[240px] items-center justify-center rounded-[6px] bg-[#0055AA] px-6 py-3 text-[15px] font-bold text-white shadow-[0_4px_14px_rgba(0,85,170,0.3)] transition hover:-translate-y-0.5 hover:bg-[#004488] !text-white"
                >
                  {content.ctaLabel}
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
