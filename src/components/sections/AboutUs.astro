---
import type { AboutSectionContent } from '../../content/home';

interface Props {
  content: AboutSectionContent;
}

const { content } = Astro.props;
---

<section id="about" class="bg-slate-50 px-4 py-12 lg:px-0">
  <div class="layout-shell">
    <div class="grid gap-6 overflow-hidden rounded-[24px] border border-[#e5e5e5] bg-white p-6 shadow-[0_12px_28px_rgba(0,0,0,0.10)] lg:grid-cols-[1.1fr_0.9fr] lg:p-10 min-h-[430px] lg:min-h-[470px]">
      <div class="flex flex-col items-center justify-center gap-3 text-center">
        <h2
          class="text-[30px] font-bold uppercase leading-[40px] tracking-[-1px] text-[#2964AF] sm:text-[36px] sm:leading-[46px] lg:text-[48px] lg:leading-[56px] lg:tracking-[-1.92px]"
          style="font-family: 'Inter', 'Inter', sans-serif;"
        >
          {content.title}
        </h2>
        <p class="max-w-xl text-center text-[16px] font-normal leading-[19px] text-[#323338] sm:text-[16px] sm:leading-[19px]">
          {content.body}
        </p>
        <a
          href="#mission"
          class="mt-2 inline-flex w-fit items-center gap-1 text-[16px] font-semibold text-[#0055AA] underline decoration-2 underline-offset-4 transition hover:text-[#003f82]"
          style="font-family: 'Inter', sans-serif;"
        >
          {content.ctaLabel} &gt;
        </a>
      </div>
      <div class="relative flex items-center justify-end">
        <div class="relative w-full max-w-md overflow-hidden rounded-[12px] bg-white shadow-[0_10px_24px_rgba(0,0,0,0.12)] h-[316px]">
          <img src="/images/figma-41-580.png" alt="Map showing Every Nation Vietnam" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
