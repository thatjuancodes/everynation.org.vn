---
import type { AboutSectionContent } from "../../content/home";

interface Props {
  content: AboutSectionContent;
}

const { content } = Astro.props;
---

<section id="about" class="bg-slate-50 px-4 py-12 lg:px-0">
  <div class="layout-shell">
    <div
      class="relative grid gap-2 overflow-hidden rounded-[24px] border border-[#e5e5e5] bg-white p-6 shadow-[0_12px_28px_rgba(0,0,0,0.10)] lg:grid-cols-[0.7fr_1.3fr] lg:py-8 lg:pl-12 lg:pr-10 min-h-[350px] lg:min-h-[400px]"
    >
      <!-- Background Texture -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img
          src="/images/about-us-image-11.png"
          alt=""
          class="h-full w-full object-cover opacity-40 mix-blend-multiply"
        />
      </div>

      <div
        class="relative z-10 flex flex-col items-center justify-center gap-6 text-center"
      >
        <div class="space-y-4">
          <h2
            class="text-[32px] font-bold uppercase leading-tight tracking-[-1px] text-[#2964AF] sm:text-[42px] lg:text-[48px]"
            style="font-family: 'Inter', 'Inter', sans-serif;"
          >
            {content.title}
          </h2>
          <p
            class="whitespace-pre-line text-[14px] font-medium leading-relaxed text-[#555] sm:text-[15px] lg:text-[15px]"
          >
            {content.body}
          </p>
        </div>

        <a
          href="#mission"
          class="inline-flex w-fit items-center gap-1 text-[15px] font-bold !text-[#0055AA] transition hover:gap-2 hover:!text-[#003f82]"
          style="font-family: 'Inter', sans-serif;"
        >
          <span
            class="underline decoration-2 underline-offset-4 !decoration-[#0055AA]"
            >{content.ctaLabel}</span
          >
          <span>&gt;</span>
        </a>
      </div>
      <div class="relative z-20 flex items-center justify-end">
        <div
          class="relative w-full overflow-hidden rounded-[12px] bg-white shadow-[0_10px_24px_rgba(0,0,0,0.12)] h-[260px] lg:h-[340px]"
        >
          <img
            src="/images/figma-41-580.png"
            alt="Map showing Every Nation Vietnam"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
