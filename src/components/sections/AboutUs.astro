---
import type { AboutSectionContent } from "../../content/home";

interface Props {
  content: AboutSectionContent;
}

const { content } = Astro.props;
---

<section id="about" class="bg-slate-50 px-4 py-6 lg:py-12 lg:px-0">
  <div class="layout-shell">
    <div
      class="relative overflow-hidden rounded-[24px] border border-[#e5e5e5] bg-white p-6 shadow-[0_12px_28px_rgba(0,0,0,0.10)] lg:grid lg:grid-cols-[0.7fr_1.3fr] lg:gap-2 lg:py-8 lg:pl-12 lg:pr-10 min-h-[350px] lg:min-h-[400px]"
    >
      <!-- Background Texture -->
      <div class="absolute inset-0 z-0 pointer-events-none">
        <img
          src="/images/about-us-image-11.png"
          alt=""
          class="h-full w-full object-cover opacity-40 mix-blend-multiply"
        />
      </div>

      <!-- Mobile: flex-col with order; Desktop: grid col 1 -->
      <div
        class="relative z-10 flex flex-col items-center gap-4 text-center lg:justify-center lg:gap-6"
      >
        <!-- Title: order-1 on mobile -->
        <h2
          class="order-1 text-[32px] font-bold uppercase leading-[40px] tracking-[-1.92px] text-[#2964AF] sm:text-[42px] lg:text-[48px] lg:leading-[56px]"
          style="font-family: 'Inter', 'Inter', sans-serif;"
        >
          {content.title}
        </h2>

        <!-- Image: order-2 on mobile (shown inline), hidden on lg (shown in grid col 2) -->
        <div class="order-2 relative z-20 w-full lg:hidden px-4">
          <div
            class="relative w-full overflow-hidden rounded-[12px] bg-white shadow-[0_10px_24px_rgba(0,0,0,0.12)] h-[150px]"
          >
            <img
              src="/images/figma-41-580.png"
              alt="Map showing Every Nation Vietnam"
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Body: order-3 on mobile -->
        <p
          class="order-3 whitespace-pre-line text-[16px] font-medium leading-[24px] text-[#555] line-clamp-5 sm:line-clamp-none"
        >
          {content.body}
        </p>

        <!-- CTA: order-4 on mobile -->
        <a
          href="/about"
          class="order-4 w-fit text-[16px] font-semibold leading-[19px] !text-[#0055AA] !underline decoration-solid decoration-auto underline-offset-auto"
          style="font-family: 'Inter', sans-serif;"
        >
          {content.ctaLabel}<span>&gt;</span>
        </a>
      </div>

      <!-- Desktop only: image in grid col 2 -->
      <div class="relative z-20 hidden lg:flex items-center justify-end">
        <div
          class="relative w-full overflow-hidden rounded-[12px] bg-white shadow-[0_10px_24px_rgba(0,0,0,0.12)] h-[260px] lg:h-[340px]"
        >
          <img
            src="/images/figma-41-580.png"
            alt="Map showing Every Nation Vietnam"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
