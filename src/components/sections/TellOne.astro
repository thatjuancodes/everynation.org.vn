---
---

<section id="tell-one" class="bg-white px-4 pt-3 pb-6 lg:pt-6 lg:pb-12 lg:px-0 relative overflow-hidden">
  <!-- Background Texture -->
  <div
    class="absolute inset-0 opacity-15 bg-[url('/images/group-8-texture-2-gray-1.png')] bg-cover bg-center mix-blend-overlay pointer-events-none"
  >
  </div>

  <div class="layout-shell relative z-10">
    <!-- Mobile & Tablet: Matches MissionStats dimensions -->
    <div
      class="lg:hidden relative overflow-hidden rounded-[18px] md:rounded-[24px] border border-[#e5e5e5] shadow-[0_12px_28px_rgba(0,0,0,0.10)] w-full min-h-[200px] md:min-h-[260px] flex items-center justify-center bg-black"
    >
      <img
        src="/images/tell-one-mobile.jpg"
        alt="Tell One - Làm chứng cho một người"
        class="w-full h-full object-cover block"
        loading="lazy"
      />
    </div>

    <!-- Desktop: Static Image Banner -->
    <div
      class="hidden lg:block w-full relative rounded-[20px] lg:rounded-[24px] overflow-hidden shadow-[0_12px_28px_rgba(0,0,0,0.10)] border border-[#e5e5e5]"
    >
      <img
        src="/images/QR_TELL ONE.jpg"
        alt="Tell One - Làm chứng cho một người"
        class="w-full h-auto object-cover block hover:scale-[1.01] transition-transform duration-300"
        loading="lazy"
      />
    </div>
  </div>
</section>
