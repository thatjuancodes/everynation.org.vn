---
import type { LifeGroupContent } from "../../content/home";

interface Props {
  content: LifeGroupContent;
}

const { content } = Astro.props;
---

<section id="connect" class="bg-[#f2f2f2] px-4 py-10 lg:px-0">
  <div class="layout-shell">
    <div
      class="grid gap-6 overflow-hidden rounded-[18px] border border-slate-200 bg-white p-10 shadow-[0_12px_32px_rgba(0,0,0,0.08)] backdrop-blur lg:grid-cols-[1.05fr_0.95fr] lg:p-14"
      style="background-image: url('/images/figma-12-2035.png'); background-size: cover; background-position: center;"
    >
      <div
        class="relative order-last min-h-[400px] w-full lg:order-first lg:min-h-[340px]"
      >
        <div
          class="absolute top-10 left- z-30 w-25 sm:left-18 sm:w-34 lg:top-5 lg:left-26 lg:w-[140px]"
        >
          <img
            src="/images/arow2.png"
            alt=""
            class="w-full object-contain"
            style="transform: rotate(-10deg);"
          />
        </div>

        <div
          class="absolute -right-12 top-18 z-15 w-[60%] overflow-hidden shadow-[0_14px_34px_rgba(0,0,0,0.15)] sm:w-[57%] lg:-right-12 lg:top-2 lg:w-[62%]"
        >
          <img
            src="/images/figma-12-2043.png"
            alt="Gathering during fellowship"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>

        <div
          class="absolute left-6 top-20 z-20 w-[55%] overflow-hidden shadow-[0_14px_34px_rgba(0,0,0,0.15)] sm:w-[52%] lg:left-0.5 lg:top-16 lg:w-[56%]"
        >
          <img
            src="/images/figma-12-2044.png"
            alt="Group photo in community space"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div
        class="flex flex-col items-center justify-center gap-4 text-center lg:py-10 lg:px-8"
      >
        <h2
          class="text-center text-[30px] font-bold uppercase leading-[40px] tracking-[-1px] text-[#2964AF] sm:text-[36px] sm:leading-[46px] lg:text-[48px] lg:leading-[56px] lg:tracking-[-1.92px]"
          style="font-family: 'Inter', 'Inter', sans-serif;"
        >
          {
            content.title
              .split("\\n")
              .map((line) => <span class="block">{line}</span>)
          }
        </h2>
        <a
          href="#connect"
          class="inline-flex min-w-[240px] items-center justify-center rounded-[6px] bg-[#0055AA] px-6 py-3 text-[15px] font-bold text-white shadow-[0_4px_14px_rgba(0,85,170,0.3)] transition hover:-translate-y-0.5 hover:bg-[#004488] !text-white"
        >
          {content.ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
