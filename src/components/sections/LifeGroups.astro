---
import type { LifeGroupContent } from '../../content/home';

interface Props {
  content: LifeGroupContent;
}

const { content } = Astro.props;
---

<section id="connect" class="bg-[#f2f2f2] px-4 py-20 lg:px-0">
  <div class="layout-shell">
    <div
      class="grid gap-6 overflow-hidden rounded-[18px] border border-slate-200 bg-white p-10 shadow-[0_12px_32px_rgba(0,0,0,0.08)] backdrop-blur lg:grid-cols-[1.05fr_0.95fr] lg:p-14"
      style="background-image: url('/images/figma-12-2035.png'); background-size: cover; background-position: center;"
    >
      <div class="order-last lg:order-first">
        <div class="relative flex items-start justify-center gap-4">
          <div class="relative w-[60%] max-w-[340px] -translate-x-2 translate-y-8 overflow-hidden rounded-[14px] shadow-[0_12px_30px_rgba(0,0,0,0.12)] sm:max-w-[360px]">
            <img src="/images/figma-12-2044.png" alt="Group photo in community space" class="h-full w-full object-cover" loading="lazy" />
          </div>
          <div class="relative w-[70%] max-w-[500px] -ml-6 overflow-hidden rounded-[14px] shadow-[0_14px_34px_rgba(0,0,0,0.14)] sm:max-w-[520px]">
            <img src="/images/figma-12-2043.png" alt="Gathering during fellowship" class="h-full w-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>
      <div class="flex flex-col items-center justify-center gap-4 text-center">
        <h2
          class="text-center text-[30px] font-bold uppercase leading-[40px] tracking-[-1px] text-[#2964AF] sm:text-[36px] sm:leading-[46px] lg:text-[48px] lg:leading-[56px] lg:tracking-[-1.92px]"
          style="font-family: 'Inter', 'Inter', sans-serif;"
        >
          {content.title.split('\\n').map((line) => (
            <span class="block">{line}</span>
          ))}
        </h2>
        <a
          href="#connect"
          class="mt-2 inline-flex w-fit items-center justify-center rounded-[4px] bg-[#0055AA] px-[18px] py-[12px] text-[16px] font-semibold text-white shadow-[0_10px_22px_rgba(0,0,0,0.15)] transition hover:-translate-y-0.5 hover:bg-[#004285] !text-white"
          style="font-family: 'Inter', sans-serif;"
        >
          {content.ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>
