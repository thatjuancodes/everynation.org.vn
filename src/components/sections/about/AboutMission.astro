---
interface Props {
    content: {
        title: string;
        body: string;
        ctaLabel: string;
        ctaLink: string;
        image: string;
    };
}
const { content } = Astro.props;
---

<section
    id="mission"
    class="relative flex flex-col gap-4 overflow-hidden border border-[#E5E5E5] bg-white p-4 shadow-sm lg:grid lg:min-h-[280px] lg:grid-cols-[0.45fr_0.55fr] lg:gap-6 lg:items-center lg:p-10 lg:rounded-[32px]"
>
    <!-- Background Image -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <img
            src="/images/about-us-image-11.png"
            alt=""
            class="h-full w-full object-cover opacity-60"
        />
    </div>

    <h2
        class="relative z-10 text-center text-[32px] font-bold uppercase leading-[40px] text-[#2964AF] sm:text-[40px] lg:hidden"
        style="font-family: 'Inter', sans-serif;"
        set:html={content.title}
    />

    <div class="relative z-10 lg:order-last">
        <div
            class="h-[120px] sm:h-[160px] lg:h-[280px] w-full lg:overflow-hidden lg:shadow-lg"
        >
            <img
                src={content.image}
                alt=""
                class="h-full w-full object-cover"
            />
        </div>
    </div>
    <div
        class="relative z-10 flex flex-col items-center gap-2 lg:gap-8 text-center mt-2 lg:mt-0"
    >
        <h2
            class="hidden lg:block text-[32px] font-bold uppercase leading-[40px] text-[#2964AF] sm:text-[40px] lg:text-[48px] lg:leading-[56px]"
            style="font-family: 'Inter', sans-serif;"
            set:html={content.title}
        />
        <p
            class="w-full text-center text-[15px] sm:text-[16px] font-semibold md:font-bold leading-[22px] md:leading-[26px] !text-[#0055AA]"
            set:html={content.body}
        />
        <a
            href={content.ctaLink}
            class="text-[16px] font-semibold leading-[19px] !text-[#0055AA] !underline decoration-solid decoration-auto underline-offset-auto"
        >
            {content.ctaLabel}
        </a>
    </div>
</section>
