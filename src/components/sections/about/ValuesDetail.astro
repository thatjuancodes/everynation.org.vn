---
const { content } = Astro.props;
---

<section class="layout-shell pt-8 bg-[">
  <div class="flex flex-col gap-6">  
    <!-- Top Map Image -->
        <div class="w-full flex justify-center">
            <img
                src={content.images?.map}
                alt="World Map"
                class="h-[371px] w-[1196px] object-cover"
            />
        </div>  
  <div class="bg-[#F6F6F6] p-8 sm:p-12 lg:p-16 flex flex-col gap-12 sm:gap-16 shadow-sm">
    <!-- Intro -->
    <div class="text-center space-y-6">
      <h2
        class="text-[28px] font-bold uppercase leading-[34px] tracking-[-0.56px] text-[#0055AA]"
        style="font-family: 'Inter', sans-serif;"
      >
        {content.intro?.title}
      </h2>
      <p class="text-[20px] font-semibold leading-[24px] text-[#2964AF] max-w-5xl mx-auto" set:html={content.intro?.description} />
    </div>

    <!-- Values List -->
    <div class="flex flex-col gap-12 w-fit mx-auto">
      {content.values?.map((value : any) => (
        <div class="flex flex-col sm:flex-row gap-6 items-center">
          <!-- Icon Circle -->
          <div class="shrink-0 mx-auto sm:mx-0">
             <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full bg-[#2964AF] flex items-center justify-center text-white shadow-md">
                {value.icon === 'lordship' && (
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7 11 5-5 5 5"/><path d="m7 17 5-5 5 5"/></svg>
                )}
                 {value.icon === 'evangelism' && (
                   <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
                )}
                 {value.icon === 'discipleship' && (
                   <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                )}
                 {value.icon === 'leadership' && (
                   <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="m5 12 7-7 7 7"/></svg>
                )}
                 {value.icon === 'family' && (
                   <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 sm:w-12 sm:h-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                )}
             </div>
          </div>
          
          <!-- Content -->
          <div class="flex-1 space-y-2 text-center sm:text-left">
            <h3 class="text-[32px] font-bold text-[#2964AF] uppercase leading-[40px] tracking-[-0.64px]">{value.title}</h3>
            <p class="text-[16px] font-normal leading-[19px] text-black">
                <span set:html={value.description} />
                <br/>
                <span class="font-bold text-black uppercase block mt-2 leading-[19px]">{value.verse}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
