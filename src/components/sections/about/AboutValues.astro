---
interface Props {
    content: {
        title: string;
        body: string;
        ctaLabel: string;
        ctaLink: string;
        image: string;
    };
}
const { content } = Astro.props;
---

<section
    class="relative grid min-h-[360px] gap-10 overflow-hidden rounded-[32px] border border-[#E5E5E5] bg-white p-10 shadow-sm lg:grid-cols-2 lg:items-center lg:p-14"
>
    <!-- Background Image -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <img
            src="/images/about-us-image-4.png"
            alt=""
            class="h-full w-full object-cover opacity-60"
        />
    </div>

    <div class="relative z-10 lg:order-last">
        <div class="overflow-hidden rounded-[16px] shadow-lg">
            <img
                src={content.image}
                alt=""
                class="h-auto w-full object-cover"
            />
        </div>
    </div>
    <div class="relative z-10 flex flex-col items-center gap-8 text-center">
        <h2
            class="text-[32px] font-bold uppercase leading-[40px] tracking-[-1.92px] text-[#2964AF] sm:text-[40px] lg:text-[48px] lg:leading-[56px]"
            style="font-family: 'Inter', sans-serif;"
        >
            {content.title}
        </h2>
        <p
            class="max-w-md text-center text-[16px] font-normal leading-[19px] text-[#323338]"
        >
            {content.body}
        </p>
        <a
            href={content.ctaLink}
            class="text-[16px] font-semibold leading-[19px] !text-[#0055AA] !underline decoration-solid decoration-auto underline-offset-auto"
        >
            {content.ctaLabel}
        </a>
    </div>
</section>
