---
interface Props {
    content: any;
}

const { content } = Astro.props;
---

<section class="bg-[#F6F6F6] py-8">
    <div class="layout-shell flex flex-col gap-4 md:gap-6">
        <!-- Top Map Image -->
        <div class="w-full flex justify-center">
            <img
                src={content.images?.map}
                alt="World Map"
                class="h-[160px] md:h-[371px] w-full max-w-[1196px] object-cover mx-auto"
            />
        </div>

        <!-- Mission Statement Description -->
        <div class="w-full text-center px-4 mt-4 mb-4">
            <p
                class="mx-auto w-full text-[15px] sm:text-[16px] md:text-[18px] font-semibold md:font-bold leading-[22px] md:leading-[26px] text-[#0055AA]"
                style="font-family: 'Inter', sans-serif;"
                set:html={content.missionStatement?.description}
            />
        </div>

        <!-- Image Grid -->
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <!-- Left: Large Vertical Image (Passport) -->
            <div class="h-full w-full overflow-hidden">
                <img
                    src={content.images?.passport}
                    alt="Mission Context"
                    class="h-full w-full object-cover"
                />
            </div>

            <!-- Right: Grid of 4 images -->
            <div class="flex h-full flex-col gap-4">
                <!-- Top Row: Unequal split (approx 1/3 and 2/3) -->
                <div class="grid h-full grid-cols-3 gap-4">
                    <div class="col-span-1 overflow-hidden">
                        <img
                            src={content.images?.grid1}
                            alt="Mission Scene 1"
                            class="h-full w-full object-cover"
                        />
                    </div>
                    <div class="col-span-2 overflow-hidden">
                        <img
                            src={content.images?.grid2}
                            alt="Mission Scene 2"
                            class="h-full w-full object-cover"
                        />
                    </div>
                </div>

                <!-- Bottom Row: Equal split -->
                <div class="grid h-full grid-cols-2 gap-4">
                    <div class="overflow-hidden">
                        <img
                            src={content.images?.grid3}
                            alt="Mission Scene 3"
                            class="h-full w-full object-cover"
                        />
                    </div>
                    <div class="overflow-hidden">
                        <img
                            src={content.images?.grid4}
                            alt="Mission Scene 4"
                            class="h-full w-full object-cover"
                        />
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer Text -->
        <div class="mt-4 text-center">
            <p
                class="mx-auto w-full px-4 mt-4 md:mt-0 text-[#0055AA] font-bold text-[18px] sm:text-[22px] md:text-[28px] leading-[26px] md:leading-[34px]"
                style="font-family: 'Inter', sans-serif;"
                set:html={content.footerText?.line1}
            />
            <p
                class="mx-auto w-full px-4 mt-1 text-[#0055AA] font-bold text-[18px] sm:text-[22px] md:text-[28px] leading-[26px] md:leading-[34px]"
                style="font-family: 'Inter', sans-serif;"
                set:html={content.footerText?.line2}
            />
        </div>
    </div>
</section>
