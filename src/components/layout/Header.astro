---
import type { LanguageOption, NavLink } from "../../content/navigation";

type CTA = {
  label: string;
  href: string;
};

interface Props {
  links?: NavLink[];
  languages?: LanguageOption[];
  logoHref?: string;
  cta?: CTA | null;
  activeHref?: string;
}

const {
  links = [],
  languages = [],
  logoHref = "/",
  cta = null,
  activeHref = "/",
} = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur"
>
  <div class="layout-shell flex items-center justify-between gap-4 py-7">
    <a href={logoHref} class="flex items-center gap-4">
      <img
        src="/images/logo.svg"
        alt="Every Nation Vietnam"
        class="h-11 w-auto sm:h-14"
        loading="lazy"
      />
    </a>

    <button
      class="lg:hidden rounded-full p-2 text-slate-700 transition hover:bg-slate-100"
      type="button"
      aria-label="Toggle navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
      </svg>
    </button>

    <nav
      class="hidden items-center gap-8 text-[16px] font-semibold leading-[160%] text-[#989898] lg:flex lg:ml-auto"
    >
      {
        links.map((link) => {
          const isActive =
            link.href === activeHref ||
            (activeHref === "/" && link.label.toLowerCase() === "home");
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class={`nav-link flex w-fit items-center justify-center gap-1 rounded-full px-2 py-1 text-center transition ${
                isActive
                  ? "text-[#2964AF] underline decoration-2 underline-offset-8"
                  : "text-[#989898] hover:text-[#2964AF]"
              }`}
            >
              <span>{link.label}</span>
              {link.sublabel && (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  class="h-3 w-3 text-slate-500"
                  fill="currentColor"
                >
                  <path d="M5 7.5 10 12.5 15 7.5H5Z" />
                </svg>
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      {
        languages.length > 0 && (
          <div class="hidden items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2 py-1 sm:flex">
            {languages.map((lang) => {
              const flagSrc =
                lang.code === "vi"
                  ? "/images/vn-flag.png"
                  : "/images/us-flag.png";
              return (
                <span
                  class="flex items-center gap-1 rounded-full p-1 transition hover:bg-white"
                  aria-label={`Switch to ${lang.label}`}
                >
                  <img
                    src={flagSrc}
                    alt={`${lang.label} flag`}
                    class="h-4 w-auto"
                    loading="lazy"
                  />
                </span>
              );
            })}
          </div>
        )
      }
      {
        cta && (
          <a
            class="hidden rounded-full bg-sky-700 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-sky-200 transition hover:bg-sky-800 lg:inline-block"
            href={cta.href}
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </div>

  <style>
    .nav-link {
      color: #989898;
      transition: color 160ms ease;
    }
    .nav-link:hover {
      color: #2964af;
    }
  </style>

  <div class="relative lg:hidden">
    <div
      class="absolute left-0 right-0 top-full z-40 hidden border-t border-slate-200 bg-white px-4 py-4 text-sm text-slate-800 shadow-[0_12px_30px_rgba(0,0,0,0.12)]"
      data-mobile-nav
      aria-hidden="true"
    >
      <nav class="flex flex-col gap-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 font-semibold transition hover:bg-slate-50 hover:text-[#1b4f9b]"
              data-close-nav
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      {
        languages.length > 0 && (
          <div class="mt-4 flex items-center gap-2 text-xs font-semibold text-slate-700">
            {languages.map((lang) => {
              const flagSrc =
                lang.code === "vi"
                  ? "/images/vn-flag.png"
                  : "/images/us-flag.png";
              return (
                <span class="flex items-center gap-1 rounded-full border border-slate-200 bg-slate-50 px-2 py-1">
                  <img
                    src={flagSrc}
                    alt={`${lang.label} flag`}
                    class="h-4 w-auto"
                    loading="lazy"
                  />
                  {lang.label}
                </span>
              );
            })}
          </div>
        )
      }
      {
        cta && (
          <a
            href={cta.href}
            class="mt-4 inline-flex w-full items-center justify-center rounded-[6px] bg-[#1b4f9b] px-4 py-3 text-sm font-semibold text-white shadow-[0_10px_20px_rgba(27,79,155,0.25)] transition hover:-translate-y-0.5 hover:bg-[#144388]"
            data-close-nav
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </div>

  <script type="module">
    const toggle = document.querySelector("[data-menu-toggle]");
    const panel = document.querySelector("[data-mobile-nav]");
    const closers = document.querySelectorAll("[data-close-nav]");
    if (toggle && panel) {
      let open = false;
      const sync = () => {
        toggle.setAttribute("aria-expanded", String(open));
        panel.setAttribute("aria-hidden", String(!open));
        panel.classList.toggle("hidden", !open);
      };
      sync();
      toggle.addEventListener("click", () => {
        open = !open;
        sync();
      });
      closers.forEach((closeEl) =>
        closeEl.addEventListener("click", () => {
          open = false;
          sync();
        }),
      );
    }
  </script>
</header>
