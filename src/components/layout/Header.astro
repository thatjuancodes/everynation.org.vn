---
import type { LanguageOption, NavLink } from "../../content/navigation";
import { getTranslatedPath } from "../../utils/i18n";

type CTA = {
  label: string;
  href: string;
};

interface Props {
  links?: NavLink[];
  languages?: LanguageOption[];
  logoHref?: string;
  cta?: CTA | null;
  activeHref?: string;
}

const {
  links = [],
  languages = [],
  logoHref = "/",
  cta = null,
  activeHref = "/",
} = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-sm backdrop-blur relative"
>
  <div
    class="layout-shell flex items-center justify-between py-4 px-4 lg:gap-4 lg:py-7 lg:px-0"
  >
    <!-- Left: Flags on Mobile, Hidden on Desktop -->
    <div class="flex shrink-0 items-center justify-start gap-2 lg:hidden z-10">
      {
        languages.length > 0 &&
          languages.map((lang) => {
            const flagSrc =
              lang.code === "vi"
                ? "/images/vn-flag.png"
                : "/images/us-flag.png";
            return (
              <a
                href={getTranslatedPath(Astro.url.pathname, lang.code)}
                class="flex items-center justify-center"
              >
                <img
                  src={flagSrc}
                  alt={`${lang.label} flag`}
                  class="h-6 w-auto object-contain"
                  loading="lazy"
                />
              </a>
            );
          })
      }
    </div>

    <!-- Center: Logo -->
    <div
      class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none lg:relative lg:inset-auto lg:h-auto lg:justify-start lg:pointer-events-auto mx-auto lg:mx-0"
    >
      <a
        href={logoHref}
        class="flex items-center justify-center pointer-events-auto w-fit"
      >
        <img
          src="/images/logo.svg"
          alt="Every Nation Vietnam"
          class="h-10 w-auto sm:h-14 lg:h-14"
          loading="lazy"
        />
      </a>
    </div>

    <!-- Right: Hamburger -->
    <div class="flex shrink-0 items-center justify-end lg:hidden z-10 w-12">
      <button
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-[#0055AA] transition hover:bg-slate-100"
        type="button"
        style="padding: 0; min-width: 40px;"
        aria-label="Toggle navigation"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <!-- Desktop Navigation Base -->
    <nav
      class="hidden items-center gap-8 text-[16px] font-semibold leading-[160%] text-[#989898] lg:flex lg:ml-auto"
    >
      {
        links.map((link) => {
          const isActive =
            link.href === activeHref ||
            (link.href !== "/" && activeHref.startsWith(link.href)) ||
            (link.items &&
              link.items.some((item) => item.href === activeHref)) ||
            (activeHref === "/" && link.label.toLowerCase() === "home");
          const hasItems = link.items && link.items.length > 0;

          if (hasItems) {
            return (
              <div class="group relative">
                <a
                  href="javascript:void(0)"
                  aria-current={isActive ? "page" : undefined}
                  class={`nav-link flex w-fit items-center justify-center gap-1 rounded-full px-2 py-1 text-center transition ${
                    isActive
                      ? "!text-[#2964AF]"
                      : "text-[#989898] hover:text-[#2964AF]"
                  }`}
                >
                  <span>{link.label}</span>
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 20 20"
                    class="h-4 w-4 text-slate-400 transition-transform duration-200 group-hover:rotate-180"
                    fill="currentColor"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>

                <div class="invisible absolute left-0 top-full w-max min-w-[200px] opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 pt-2">
                  <div class="border border-slate-100 bg-white py-3 shadow-xl ring-1 ring-slate-900/5">
                    {link.items?.map((item) => (
                      <a
                        href={item.href}
                        class="block px-6 py-2.5 text-[15px] font-medium text-[#989898] hover:!text-[#2964AF]"
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }

          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class={`nav-link flex w-fit items-center justify-center gap-1 rounded-full px-2 py-1 text-center transition ${
                isActive
                  ? "!text-[#2964AF] underline decoration-2 underline-offset-8"
                  : "text-[#989898] hover:text-[#2964AF]"
              }`}
            >
              <span>{link.label}</span>
              {link.sublabel && (
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  class="h-3 w-3 text-slate-500"
                  fill="currentColor"
                >
                  <path d="M5 7.5 10 12.5 15 7.5H5Z" />
                </svg>
              )}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      {
        languages.length > 0 && (
          <div class="hidden items-center gap-2 rounded-full border border-slate-200 bg-slate-50 px-2 py-1 sm:flex">
            {languages.map((lang) => {
              const flagSrc =
                lang.code === "vi"
                  ? "/images/vn-flag.png"
                  : "/images/us-flag.png";
              return (
                <a
                  href={getTranslatedPath(Astro.url.pathname, lang.code)}
                  class="flex items-center gap-1 rounded-full p-1 transition hover:bg-white"
                  aria-label={`Switch to ${lang.label}`}
                >
                  <img
                    src={flagSrc}
                    alt={`${lang.label} flag`}
                    class="h-4 w-auto"
                    loading="lazy"
                  />
                </a>
              );
            })}
          </div>
        )
      }
      {
        cta && (
          <a
            class="hidden rounded-full bg-sky-700 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-sky-200 transition hover:bg-sky-800 lg:inline-block"
            href={cta.href}
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    class="absolute left-0 right-0 top-full z-40 hidden border-t border-slate-200 bg-white px-4 py-4 text-sm text-slate-800 shadow-[0_12px_30px_rgba(0,0,0,0.12)] lg:hidden"
    data-mobile-nav
    aria-hidden="true"
  >
    <nav class="flex flex-col">
      {
        links.map((link, idx) => (
          <>
            {idx > 0 && <hr class="border-[#1b4f9b]/30 mx-3" />}
            <div class="py-3">
              <a
                href={
                  link.items && link.items.length > 0
                    ? "javascript:void(0)"
                    : link.href
                }
                class="block px-3 py-1 font-bold text-[18px]"
                style="color: #0055AA !important;"
                data-close-nav={!link.items ? "" : undefined}
              >
                {link.label}
              </a>
              {link.items && (
                <div class="mt-2 flex flex-col pl-6 gap-2">
                  {link.items.map((item) => (
                    <a
                      href={item.href}
                      class="block px-3 py-1 text-[15px]"
                      style="color: #0055AA !important;"
                      data-close-nav
                    >
                      {item.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </>
        ))
      }
    </nav>
    {
      cta && (
        <a
          href={cta.href}
          class="mt-4 inline-flex w-full items-center justify-center rounded-[6px] bg-[#1b4f9b] px-4 py-3 text-sm font-semibold text-white shadow-[0_10px_20px_rgba(27,79,155,0.25)] transition hover:-translate-y-0.5 hover:bg-[#144388]"
          data-close-nav
        >
          {cta.label}
        </a>
      )
    }
  </div>

  <script type="module">
    const toggle = document.querySelector("[data-menu-toggle]");
    const panel = document.querySelector("[data-mobile-nav]");
    const closers = document.querySelectorAll("[data-close-nav]");
    if (toggle && panel) {
      let open = false;
      const sync = () => {
        toggle.setAttribute("aria-expanded", String(open));
        panel.setAttribute("aria-hidden", String(!open));
        panel.classList.toggle("hidden", !open);
      };
      sync();
      toggle.addEventListener("click", () => {
        open = !open;
        sync();
      });
      closers.forEach((closeEl) =>
        closeEl.addEventListener("click", () => {
          open = false;
          sync();
        }),
      );
    }
  </script>
</header>
