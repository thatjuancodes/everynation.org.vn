---
import type { NavLink } from "../../content/navigation";

interface SocialLink {
  label: string;
  href: string;
  icon: "facebook" | "youtube";
}

interface Props {
  links: NavLink[];
  socials: SocialLink[];
}

const { links, socials } = Astro.props;
---

<footer class="mt-5 border-t border-slate-200 bg-white">
  <div class="layout-shell py-10">
    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <!-- Top Row (Mobile): Logo + Social -->
      <div class="flex flex-row items-center justify-between w-full lg:w-auto">
        <div class="flex items-center gap-3">
          <img
            src="/images/logo.svg"
            alt="Every Nation Vietnam"
            class="h-auto w-[160px] sm:w-[180px]"
            loading="lazy"
          />
        </div>

        <div class="flex items-center justify-end gap-4 lg:hidden">
          {
            socials.map((social) => (
              <a
                href={social.href}
                class="transition hover:opacity-80"
                aria-label={social.label}
              >
                {social.icon === "facebook" ? (
                  <img
                    src="/images/face.png"
                    alt="Facebook"
                    class="h-6 w-6 object-contain"
                  />
                ) : (
                  <img
                    src="/images/youtube.png"
                    alt="YouTube"
                    class="h-6 w-6 object-contain"
                  />
                )}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Center: Navigation Links (Hidden on Mobile) -->
      <nav
        class="hidden lg:flex flex-wrap items-center justify-center gap-y-4 gap-x-6 sm:gap-x-9 text-[15px] sm:text-[16px] font-semibold leading-[19px] text-[#0055AA]"
      >
        {
          links.map((link) => (
            <a href={link.href} class="transition hover:opacity-80">
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right: Social Links (Desktop) -->
      <div class="hidden lg:flex items-center gap-4">
        {
          socials.map((social) => (
            <a
              href={social.href}
              class="transition hover:opacity-80"
              aria-label={social.label}
            >
              {social.icon === "facebook" ? (
                <img
                  src="/images/face.png"
                  alt="Facebook"
                  class="h-6 w-6 object-contain"
                />
              ) : (
                <img
                  src="/images/youtube.png"
                  alt="YouTube"
                  class="h-6 w-6 object-contain"
                />
              )}
            </a>
          ))
        }
      </div>
    </div>
    <p class="mt-8 text-center text-xs text-slate-500">
      © {new Date().getFullYear()} Every Nation Vietnam. All rights reserved.
    </p>
  </div>
</footer>
