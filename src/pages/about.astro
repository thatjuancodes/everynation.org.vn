---
import SiteLayout from "../components/layout/SiteLayout.astro";
import AboutHero from "../components/sections/about/AboutHero.astro";
import AboutMission from "../components/sections/about/AboutMission.astro";
import AboutValues from "../components/sections/about/AboutValues.astro";
import AboutFaith from "../components/sections/about/AboutFaith.astro";
import { aboutPageContent } from "../content/about";
import { siteMeta, footerLinks } from "../content/home";
import { navLinks, socialLinks, languageOptions } from "../content/navigation";

const { hero, mission, values, faith } = aboutPageContent;
---

<SiteLayout
    title={`About Us | ${siteMeta.title}`}
    description={siteMeta.description}
    canonical={`${siteMeta.canonical}/about`}
    navLinks={navLinks}
    footerLinks={footerLinks}
    socials={socialLinks}
    languages={languageOptions}
    activeHref="/about"
>
    <AboutHero content={hero} />
    <div class="layout-shell flex flex-col gap-10 py-20">
        <AboutMission content={mission} />
        <AboutValues content={values} />
        <AboutFaith content={faith} />
    </div>
</SiteLayout>
