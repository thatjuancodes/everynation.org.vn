---
import SiteLayout from "../components/layout/SiteLayout.astro";
import { siteMeta, footerLinks } from "../content/home";
import { navLinks, socialLinks, languageOptions } from "../content/navigation";
import DetailHero from "../components/sections/about/DetailHero.astro";
import Giving from "../components/sections/giving/Giving.astro";
import { givingContent } from "../content/giving";
---

<SiteLayout
    title={`Giving - ${siteMeta.title}`}
    description="Giving to Every Nation Vietnam"
    navLinks={navLinks}
    footerLinks={footerLinks}
    socials={socialLinks}
    languages={languageOptions}
    activeHref="/giving"
>
    <main>
        <DetailHero content={givingContent.hero} />
        <Giving content={givingContent} />
    </main>
</SiteLayout>
