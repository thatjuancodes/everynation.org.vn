---
import SiteLayout from "../../components/layout/SiteLayout.astro";
import { siteMeta, footerLinks } from "../../content/home";
import {
    navLinks,
    socialLinks,
    languageOptions,
} from "../../content/navigation";
import SermonHero from "../../components/sections/sermon/SermonHero.astro";
import LatestSermon from "../../components/sections/sermon/LatestSermon.astro";
import SermonList from "../../components/sections/sermon/SermonList.astro";
import { sermonContent } from "../../content/sermon";
import { getLangFromUrl } from "../../utils/i18n";

const lang = getLangFromUrl(Astro.url);
return Astro.redirect("/vi");
---

<SiteLayout
    title={`Sermon - ${meta.title}`}
    description="Every Nation Vietnam Sermons"
    canonical={siteMeta.canonical}
    navLinks={navLinks[lang]}
    footerLinks={footerLinks[lang]}
    socials={socialLinks}
    languages={languageOptions}
    activeHref={`/${lang}/sermon`}
>
    <main class="bg-slate-50 min-h-screen">
        <SermonHero content={content.hero} />
        <LatestSermon content={content.latestSermon} />
        <SermonList content={content.list} />
    </main>
</SiteLayout>
