---
import SiteLayout from '../components/layout/SiteLayout.astro';
import AboutUs from '../components/sections/AboutUs.astro';
import Hero from '../components/sections/Hero.astro';
import LifeGroups from '../components/sections/LifeGroups.astro';
import MissionStats from '../components/sections/MissionStats.astro';
import WeeklyGatherings from '../components/sections/WeeklyGatherings.astro';
import {
  aboutSection,
  footerLinks,
  heroContent,
  lifeGroups,
  missionStats,
  siteMeta,
  weeklyGatherings,
} from '../content/home';
import { languageOptions, navLinks, socialLinks } from '../content/navigation';
---

<SiteLayout
  title={siteMeta.title}
  description={siteMeta.description}
  canonical={siteMeta.canonical}
  ogImage={siteMeta.ogImage}
  navLinks={navLinks}
  footerLinks={footerLinks}
  socials={socialLinks}
  languages={languageOptions}
>
  <Hero content={heroContent} />
  <WeeklyGatherings content={weeklyGatherings} />
  <AboutUs content={aboutSection} />
  <LifeGroups content={lifeGroups} />
  <MissionStats content={missionStats} />
</SiteLayout>
